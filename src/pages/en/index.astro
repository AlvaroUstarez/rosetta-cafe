---
import Footer from "../../components/Footer.astro";
import Hero from "../../components/Hero.astro";
import MenuSection from "../../components/MenuSection.astro";
import SectionNav from "../../components/SectionNav.astro";
import { categories, products, protocolo } from "../../data/menu";
import type { Locale } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";

const locale: Locale = "en";
---

<BaseLayout locale={locale}>
  <Hero locale={locale} />
  <SectionNav categories={categories} locale={locale} />
  <main id="main" tabindex="-1">
    {
      categories.map((category) => (
        <MenuSection
          section={category}
          products={products.filter((product) => product.category === category.id)}
          locale={locale}
        />
      ))
    }
    <MenuSection
      section={{ id: "protocolo", label: protocolo.title }}
      protocolo={protocolo}
      locale={locale}
    />
  </main>
  <Footer locale={locale} />
</BaseLayout>
