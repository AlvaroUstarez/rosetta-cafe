---
import { getImage } from "astro:assets";
import heroImage from "../assets/hero.webp";
import type { Locale } from "../i18n";
import { t } from "../i18n";
import "../styles/global.css";

export interface Props {
  locale?: Locale;
}

const { locale = "es" } = Astro.props;

const title = t("meta.title", locale);
const description = t("meta.description", locale);
const ogLocale = locale === "es" ? "es_AR" : "en_US";
const selfPath = locale === "es" ? "/" : "/en/";
const skipLabel = t("a11y.skip", locale);

const ogImage = await getImage({
  src: heroImage,
  width: 1200,
  format: "webp",
  quality: 82,
});
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FBFAF8" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.src} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="es" href="/" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang={locale} href={selfPath} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <slot />
  </body>
</html>
