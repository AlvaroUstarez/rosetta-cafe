---
import type { Product } from "../data/menu";
import type { Locale } from "../i18n";
import { tRecord } from "../i18n";

export interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const name = tRecord(product.name, locale);
const description = tRecord(product.description, locale);
const freeLabel = locale === "en" ? "Free" : "Gratis";
---

<div class="product-list-item">
  <div class="product-list-item__row">
    <span class="product-list-item__name">{name}</span>
    <span class="product-list-item__leader" aria-hidden="true"></span>
    <span class="product-list-item__price">
      {product.price === 0 ? freeLabel : `$ ${product.price}`}
    </span>
  </div>
  {description && (
    <p class="product-list-item__description">{description}</p>
  )}
</div>

<style>
  .product-list-item {
    padding: 0.75rem 0;
    transition: background-color 0.2s ease;
    border-bottom: 1px solid var(--color-border);
  }

  .product-list-item:last-child {
    border-bottom: none;
  }

  .product-list-item:hover {
    background-color: rgba(0, 0, 0, 0.02);
    border-radius: 6px;
  }

  .product-list-item__row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .product-list-item__name {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-primary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .product-list-item__leader {
    flex: 1;
    border-bottom: 1px dotted var(--color-border);
    min-width: 1.5rem;
    margin-bottom: 0.25em;
  }

  .product-list-item__price {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-secondary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .product-list-item__description {
    font-size: 0.8125rem;
    color: var(--color-text);
    opacity: 0.65;
    line-height: 1.5;
    margin: 0.25rem 0 0;
  }

  @media (max-width: 480px) {
    .product-list-item__row {
      flex-wrap: wrap;
    }

    .product-list-item__leader {
      display: none;
    }

    .product-list-item__price {
      margin-left: auto;
    }
  }
</style>
