---
import { Image } from "astro:assets";
import type { Product } from "../data/menu";
import type { Locale } from "../i18n";
import { formatPrice, tRecord } from "../i18n";

export interface Props {
  product: Product;
  locale: Locale;
  /** When any item in the list has a photo, every row keeps the photo column. */
  plated?: boolean;
}

const { product, locale, plated = false } = Astro.props;
const name = tRecord(product.name, locale);
const description = tRecord(product.description, locale);
const priceLabel =
  product.price === 0
    ? locale === "en"
      ? "Free"
      : "Gratis"
    : formatPrice(product.price, locale);
---

<li class:list={["menu-item", { "menu-item--plated": plated }]}>
  {
    plated &&
      (product.image ? (
        <div class="menu-item__thumb">
          <Image
            src={product.image}
            alt=""
            widths={[72, 144, 216]}
            sizes="(max-width: 480px) 56px, 72px"
            format="webp"
            quality={80}
            loading="lazy"
          />
        </div>
      ) : (
        <div class="menu-item__thumb menu-item__thumb--empty" aria-hidden="true" />
      ))
  }

  <div class="menu-item__body">
    <div class="menu-item__line">
      <p class="menu-item__name">{name}</p>
      <span class="menu-item__price">{priceLabel}</span>
    </div>
    {description && <p class="menu-item__description">{description}</p>}
  </div>
</li>

<style>
  .menu-item {
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--rule);
  }

  .menu-item--plated {
    display: grid;
    grid-template-columns: var(--thumb) minmax(0, 1fr);
    column-gap: var(--space-sm);
    align-items: start;
  }

  .menu-item__thumb {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--wash);
  }

  .menu-item__thumb--empty {
    background: transparent;
  }

  .menu-item__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .menu-item__line {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--space-md);
    padding-top: 0.1rem;
  }

  .menu-item__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--ink);
  }

  .menu-item__price {
    font-size: var(--text-base);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    white-space: nowrap;
  }

  .menu-item__description {
    margin-top: var(--space-3xs);
    max-width: var(--measure-tight);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  @media (max-width: 480px) {
    .menu-item--plated {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      column-gap: var(--space-xs);
    }

    .menu-item__name {
      font-size: var(--text-md);
    }
  }
</style>
