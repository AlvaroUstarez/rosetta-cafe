---
import type { Locale } from "../i18n";
import { t } from "../i18n";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__col">
      <h2 class="footer__label">{t("footer.location.title", locale)}</h2>
      <p class="footer__value">{t("footer.location.text", locale)}</p>
    </div>

    <div class="footer__col">
      <h2 class="footer__label">{t("footer.hours.title", locale)}</h2>
      <p class="footer__value">{t("footer.hours.text", locale)}</p>
    </div>

    <div class="footer__col">
      <h2 class="footer__label">{t("footer.social.title", locale)}</h2>
      <ul class="footer__social" role="list">
        <li>
          <a href="#" class="footer__social-link" aria-label="Instagram">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="17" y1="7" x2="17.01" y2="7"></line>
            </svg>
          </a>
        </li>
        <li>
          <a href="#" class="footer__social-link" aria-label="Facebook">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3V2z"
              ></path>
            </svg>
          </a>
        </li>
        <li>
          <a href="#" class="footer__social-link" aria-label="WhatsApp">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
              ></path>
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer__inner footer__inner--bottom">
    <p class="footer__copyright">
      &copy; {new Date().getFullYear()}
      {t("footer.copyright", locale)}
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--rule);
    background: var(--wash);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-lg);
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--space-xl) var(--gutter);
  }

  .footer__label {
    margin-bottom: var(--space-2xs);
    font-family: var(--font-text);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  .footer__value {
    white-space: pre-line;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--ink);
  }

  .footer__social {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-left: -0.75rem;
  }

  .footer__social-link {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--ink-muted);
    transition: color 0.18s var(--ease);
  }

  .footer__social-link:hover {
    color: var(--ink);
  }

  .footer__inner--bottom {
    padding-block: var(--space-md);
    border-top: 1px solid var(--rule);
  }

  .footer__copyright {
    font-size: var(--text-2xs);
    letter-spacing: 0.01em;
    color: var(--ink-muted);
  }

  @media (min-width: 768px) {
    .footer__inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-xl);
    }
  }
</style>
