---
import { Image } from "astro:assets";
import { glazeTiles } from "../data/category-visual";
import type { Product } from "../data/menu";
import type { Locale } from "../i18n";
import { tRecord } from "../i18n";

export interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const name = tRecord(product.name, locale);
const description = tRecord(product.description, locale);
const glaze = glazeTiles[product.category];
---

<div class="product-cell">
  {
    product.image ? (
      <Image
        class="product-cell__image"
        src={product.image}
        alt={name}
        widths={[240, 360, 480, 720]}
        sizes="(min-width: 1100px) 346px, (min-width: 1024px) 32vw, (min-width: 768px) 46vw, calc(100vw - 2.5rem)"
        format="webp"
        quality={80}
      />
    ) : (
      <div
        class="product-cell__glaze"
        role="img"
        aria-label={name}
        style={`--glaze-fill: ${glaze.fill}; --glaze-rim: ${glaze.rim}`}
      />
    )
  }
  <div class="product-cell__body">
    <h3 class="product-cell__name">{name}</h3>
    <p class="product-cell__description">{description}</p>
    <span class="product-cell__price">$ {product.price}</span>
  </div>
</div>

<style>
  .product-cell {
    background: var(--color-surface);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .product-cell:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .product-cell__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .product-cell__glaze {
    aspect-ratio: 3 / 4;
    background-color: var(--glaze-fill);
    box-shadow: inset 0 0 0 1px var(--glaze-rim);
  }

  .product-cell__body {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-cell__name {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    color: var(--color-primary);
    margin: 0 0 0.375rem;
  }

  .product-cell__description {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.5;
    margin: 0 0 0.75rem;
    flex: 1;
  }

  .product-cell__price {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-secondary);
  }
</style>
