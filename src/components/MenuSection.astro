---
import type { Product, Protocolo } from "../data/menu";
import type { Locale } from "../i18n";
import { t, tRecord } from "../i18n";
import MenuRow from "./ProductListItem.astro";

export interface Props {
  section: {
    id: string;
    label: { es: string; en: string };
    subCategories?: { es: string[]; en: string[] };
  };
  products?: Product[];
  protocolo?: Protocolo;
  locale: Locale;
}

const { section, products, protocolo, locale } = Astro.props;
const sectionProducts = products ?? [];
const label = tRecord(section.label, locale);
const subCategoriesEs = section.subCategories?.es ?? [];
const emptyMsg = t("menu.empty", locale);
const protocoloContent = protocolo ? tRecord(protocolo.content, locale) : "";
const headingId = `heading-${section.id}`;

const groups =
  subCategoriesEs.length > 0
    ? subCategoriesEs
        .map((sub, index) => ({
          title:
            locale === "en" && section.subCategories?.en?.[index]
              ? section.subCategories.en[index]
              : sub,
          items: sectionProducts.filter(
            (product) => product.subCategory === sub,
          ),
        }))
        .filter((group) => group.items.length > 0)
    : sectionProducts.length > 0
      ? [{ title: "", items: sectionProducts }]
      : [];
---

<section
  class="menu-section"
  id={`section-${section.id}`}
  aria-labelledby={headingId}
>
  <div class="menu-section__inner">
    <h2 class="menu-section__title" id={headingId}>{label}</h2>

    {
      protocolo ? (
        <div class="menu-section__note">
          <p class="menu-section__note-text">{protocoloContent}</p>
        </div>
      ) : groups.length === 0 ? (
        <p class="menu-section__empty">{emptyMsg}</p>
      ) : (
        groups.map((group) => {
          const plated = group.items.some((product) => product.image);
          return (
            <div class="menu-group">
              {group.title && (
                <h3 class="menu-group__title">{group.title}</h3>
              )}
              <ul class="menu-list" role="list">
                {group.items.map((product) => (
                  <MenuRow
                    product={product}
                    locale={locale}
                    plated={plated}
                  />
                ))}
              </ul>
            </div>
          );
        })
      )
    }
  </div>
</section>

<style>
  .menu-section {
    border-top: 1px solid var(--rule);
  }

  .menu-section:first-child {
    border-top: none;
  }

  .menu-section__inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--space-xl) var(--gutter);
  }

  .menu-section__title {
    margin-bottom: var(--space-lg);
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .menu-group + .menu-group {
    margin-top: var(--space-lg);
  }

  .menu-group__title {
    margin-bottom: var(--space-xs);
    font-size: var(--text-xl);
    color: var(--brass-ink);
  }

  .menu-list {
    border-top: 1px solid var(--rule);
  }

  .menu-section__empty {
    padding-block: var(--space-md);
    font-size: var(--text-md);
    color: var(--ink-muted);
  }

  .menu-section__note {
    max-width: var(--measure);
    padding: var(--space-md);
    border-left: 2px solid var(--brass);
    background: var(--wash);
  }

  .menu-section__note-text {
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--ink-muted);
  }
</style>
