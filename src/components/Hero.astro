---
import { Image } from "astro:assets";
import heroImage from "../assets/hero.webp";
import type { Locale } from "../i18n";
import { t } from "../i18n";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const kind = t("hero.kind", locale);
const tagline = t("hero.tagline", locale);
---

<header class="masthead">
  <div class="masthead__inner">
    <h1 class="masthead__name">
      Rosetta
      <span class="masthead__kind">{kind}</span>
    </h1>
    <p class="masthead__tagline">{tagline}</p>
  </div>

  <div class="masthead__plate">
    <Image
      src={heroImage}
      alt=""
      priority
      widths={[480, 720, 1080, 1440]}
      sizes="(min-width: 1336px) 1144px, (min-width: 768px) calc(100vw - 7rem), calc(100vw - 2.5rem)"
      format="webp"
      quality={82}
    />
  </div>
</header>

<style>
  .masthead {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: clamp(2.5rem, 7vw, 5rem) var(--gutter) 0;
  }

  .masthead__name {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 300;
    line-height: var(--leading-display);
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .masthead__kind {
    display: block;
    margin-top: 0.85em;
    font-family: var(--font-text);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.4;
    color: var(--brass-ink);
  }

  .masthead__tagline {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    max-width: 26ch;
    font-family: var(--font-display);
    font-size: var(--text-tagline);
    font-weight: 300;
    line-height: 1.35;
    color: var(--ink-muted);
  }

  .masthead__plate {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--wash);
  }

  .masthead__plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .masthead__plate {
      aspect-ratio: 21 / 9;
    }
  }
</style>
