---
import { Image } from "astro:assets";
import heroImage from "../assets/hero.webp";
import type { Locale } from "../i18n";
import { t } from "../i18n";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__content">
      <h1 class="hero__title">Rosetta Café de Especialidad</h1>
      <p class="hero__tagline">{t("hero.tagline", locale)}</p>
    </div>
    <div class="hero__media">
      <Image
        src={heroImage}
        alt=""
        priority
        widths={[320, 480, 640, 960]}
        sizes="(min-width: 1440px) 352px, (min-width: 768px) 27vw, 100vw"
        format="webp"
        quality={80}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    padding-inline: var(--gutter);
  }

  .hero__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .hero__title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: var(--leading-display);
    color: var(--color-primary);
    margin: 0 0 var(--space-xs);
  }

  .hero__tagline {
    font-size: var(--text-lg);
    line-height: var(--leading);
    color: var(--color-text);
    margin: 0;
  }

  .hero__media {
    width: 100%;
  }

  .hero__media :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (min-width: 768px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) clamp(16rem, 26vw, 22rem);
    }

    .hero__title {
      font-size: var(--text-4xl);
    }
  }

  @media (max-width: 767px) {
    .hero__media {
      width: calc(100% + 2 * var(--gutter));
      margin-inline: calc(-1 * var(--gutter));
    }
  }
</style>
