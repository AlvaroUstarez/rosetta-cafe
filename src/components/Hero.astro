---
import { Image } from "astro:assets";
import heroImage from "../assets/hero.webp";
import logoMark from "../assets/logo-mark.webp";
import type { Locale } from "../i18n";
import { t } from "../i18n";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const kind = t("hero.kind", locale);
const tagline = t("hero.tagline", locale);
---

<header class="masthead">
  <div class="masthead__inner">
    <div class="masthead__mark">
      <Image
        src={logoMark}
        alt=""
        loading="eager"
        widths={[96, 192]}
        sizes="96px"
        format="webp"
        quality={90}
      />
    </div>

    <h1 class="masthead__name">
      Rosetta
      <span class="masthead__kind">{kind}</span>
    </h1>

    <p class="masthead__tagline">{tagline}</p>
  </div>

  <div class="masthead__plate">
    <Image
      src={heroImage}
      alt=""
      priority
      widths={[480, 720, 1080, 1440]}
      sizes="(min-width: 1336px) 1144px, (min-width: 768px) calc(100vw - 7rem), calc(100vw - 2.5rem)"
      format="webp"
      quality={82}
    />
  </div>
</header>

<style>
  .masthead {
    max-width: var(--container-wide);
    margin-inline: auto;
    padding: clamp(2.5rem, 7vw, 5rem) var(--gutter) 0;
  }

  /* Mobile first: the mark sits above the wordmark, centred like the sign over the door. */
  .masthead__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .masthead__mark {
    width: 5.5rem;
    height: 5.5rem;
    margin-bottom: clamp(1.25rem, 4vw, 1.75rem);
    border-radius: 50%;
    overflow: hidden;
    background: var(--wash);
  }

  .masthead__mark :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .masthead__name {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 300;
    line-height: var(--leading-display);
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .masthead__kind {
    display: block;
    margin-top: 0.85em;
    font-family: var(--font-text);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.4;
    color: var(--green-ink);
  }

  .masthead__tagline {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    max-width: 26ch;
    font-family: var(--font-display);
    font-size: var(--text-tagline);
    font-weight: 300;
    line-height: 1.35;
    color: var(--ink-muted);
  }

  .masthead__plate {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--wash);
  }

  .masthead__plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* From tablet up the mark leads the column and the type sits on the left margin. */
  @media (min-width: 768px) {
    .masthead__inner {
      align-items: flex-start;
      text-align: left;
    }

    .masthead__mark {
      width: 6rem;
      height: 6rem;
    }

    .masthead__plate {
      aspect-ratio: 21 / 9;
    }
  }
</style>
